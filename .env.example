# Copy this file to .env and replace development placeholders when necessary.
# The real .env file is ignored by Git and must never be committed.

FLASK_CONFIG=development
SECRET_KEY=YpH-Km12UZXxmnCTXvOzBXZs4GZ89rnypX5rirNL0gfv_1Q8ulZLbwYWtKJgOYmGa0mvkQ4aIYdM1j_qG0Gt2g

# Local XAMPP/MariaDB development database.
# This configuration uses the local root account without a password.
# Production must use a dedicated database account with a strong password.
DATABASE_URL=mysql+pymysql://root@127.0.0.1/mau_soap_dev

# Only official Modibbo Adama University email addresses may verify as Candidates.
CANDIDATE_EMAIL_DOMAIN=mau.edu.ng

# Email delivery is suppressed during local development.
# SMTP credentials will be required before production deployment.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@mau-soap.local
MAIL_SUPPRESS_SEND=true

# Default development Admin account.
# Replace this password before production deployment.
DEFAULT_ADMIN_EMAIL=admin@mau.edu.ng
DEFAULT_ADMIN_PASSWORD=Admin@123456
SEED_DUMMY_EXAM=true

# Password-reset links expire after this many minutes.
PASSWORD_RESET_MAX_AGE_MINUTES=30

# Candidate OTP/magic links expire quickly.
# Verified Candidate access lasts for this configured period.
CANDIDATE_VERIFICATION_MAX_AGE_MINUTES=10
CANDIDATE_SESSION_MAX_AGE_MINUTES=30

# Face-absence evidence is stored privately outside /static.
# Twenty-five MiB supports several minutes of low-bitrate video evidence.
SUPERVISION_EVIDENCE_MAX_BYTES=26214400
SUPERVISION_EVIDENCE_MAX_DURATION_SECONDS=3600
SUPERVISION_EVIDENCE_RETENTION_DAYS=30

# Optional absolute directory.
# When blank, the application uses instance/supervision_evidence.
SUPERVISION_EVIDENCE_DIR=