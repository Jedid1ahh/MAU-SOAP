# Copy this file to .env and replace every placeholder before starting the app.
# The real .env file is ignored by Git and must never be committed.

FLASK_CONFIG=development
SECRET_KEY=replace-with-a-long-random-value

# The application runs on the host, so localhost reaches the Docker database.
DATABASE_URL=postgresql+psycopg://mau_soap:replace-with-a-db-password@localhost:5432/mau_soap_dev

# Values consumed by compose.yaml when PostgreSQL is started with Docker.
POSTGRES_DB=mau_soap_dev
POSTGRES_USER=mau_soap
POSTGRES_PASSWORD=replace-with-a-db-password

# Gmail is intentionally used only while building and testing the system.
CANDIDATE_EMAIL_DOMAIN=gmail.com

# Email delivery is disabled in local development until real SMTP values exist.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@mau-soap.local
MAIL_SUPPRESS_SEND=true

DEFAULT_ADMIN_EMAIL=admin@mau.edu.ng
DEFAULT_ADMIN_PASSWORD=Admin@123456
SEED_DUMMY_EXAM=true

# Password-reset links expire after this many minutes.
PASSWORD_RESET_MAX_AGE_MINUTES=30

# Candidate OTP/magic links expire quickly; verified access lasts until exam start.
CANDIDATE_VERIFICATION_MAX_AGE_MINUTES=10
CANDIDATE_SESSION_MAX_AGE_MINUTES=30

# Face-absence evidence is stored privately outside /static.
SUPERVISION_EVIDENCE_MAX_BYTES=26214400
SUPERVISION_EVIDENCE_MAX_DURATION_SECONDS=3600
SUPERVISION_EVIDENCE_RETENTION_DAYS=30

# Optional absolute directory. Blank uses instance/supervision_evidence.
SUPERVISION_EVIDENCE_DIR=